# Copy to .env and fill in your own values. .env is gitignored.

# ── LLM Provider ──────────────────────────────────────────
LLM_PROVIDER=ollama

# ── Gemini (Stage 1: The Relay) ──────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# ── Groq (fallback) ───────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── OpenAI-compatible (DeepSeek, etc.) ───────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# ── Local Inference (Stage 2: Crystallizer) ──────────────
MLX_BASE_URL=http://localhost:8080/v1
MLX_MODEL=mlx-community/Qwen3-14B-4bit
MLX_MODEL_FAST=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_MODEL_FAST=
OLLAMA_KEEP_ALIVE=300

# ── DigitalOcean Spaces (cloud inbox) ────────────────────
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
SPACES_REGION=nyc3
SPACES_BUCKET=nexus-vault
SPACES_PREFIX=incoming

# ── Web Extraction ────────────────────────────────────────
JINA_API_KEY=
APIFY_API_KEY=

# ── Vault ─────────────────────────────────────────────────
OBSIDIAN_VAULT=

# ── Feature flags ─────────────────────────────────────────
COMPRESS_ENABLED=
MARKER_ENABLED=
EMBEDDING_MODEL=
