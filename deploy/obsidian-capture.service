[Unit]
Description=Obsidian Capture Pipeline Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/AgenticPKMApp

# Reads GEMINI_API_KEY, JINA_API_KEY, SPACES_* etc. — copy .env.example to
# .env in WorkingDirectory and fill in real values before starting.
# OBSIDIAN_VAULT is irrelevant on the server (return_files/cloud mode only).
EnvironmentFile=/home/ubuntu/AgenticPKMApp/.env

ExecStart=/home/ubuntu/AgenticPKMApp/.venv/bin/uvicorn server:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
